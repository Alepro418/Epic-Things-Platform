# ============================================
# VARIABLES DE ENTORNO - EPIC THINGS PLATFORM
# ============================================

# ============================================
# BASE DE DATOS (PostgreSQL)
# ============================================
POSTGRES_USER=epic_user
POSTGRES_PASSWORD=epic_password_secure
POSTGRES_DB=epic_things
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ============================================
# REDIS (Caché)
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_secure

# ============================================
# RABBITMQ (Colas)
# ============================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=epic_user
RABBITMQ_PASSWORD=rabbitmq_password_secure

# ============================================
# MINIO (Almacenamiento)
# ============================================
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=epic_user
MINIO_ROOT_PASSWORD=minio_password_secure
MINIO_BUCKET_GAMES=epic-games
MINIO_BUCKET_IMAGES=epic-images

# ============================================
# JWT (Autenticación)
# ============================================
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRATION=24h
REFRESH_TOKEN_EXPIRATION=7d

# ============================================
# STRIPE (Pagos)
# ============================================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx

# ============================================
# EMAIL (SendGrid/AWS SES)
# ============================================
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@epic-things.com

# ============================================
# FRONTEND
# ============================================
VITE_API_URL=http://localhost:80
VITE_WS_URL=ws://localhost:3006

# ============================================
# ELASTICSEARCH (Búsqueda)
# ============================================
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# ============================================
# ENTORNO
# ============================================
NODE_ENV=development
APP_NAME=Epic Things Platform