-- 2. TABLAS DE NEGOCIO
-- =============================================================================

-- 2.1 Tabla: juegos
CREATE TABLE IF NOT EXISTS juegos (
    id_juego SERIAL PRIMARY KEY,
    titulo VARCHAR(150) NOT NULL,
    descripcion TEXT,
    categoria VARCHAR(50) NOT NULL,
    tipo VARCHAR(20) NOT NULL CHECK (tipo IN ('html5', 'unity', 'webgl')),
    url_archivo VARCHAR(255) NOT NULL,
    url_imagen VARCHAR(255),
    url_demo VARCHAR(255),
    precio DECIMAL(10,2) DEFAULT 0.00,
    estado VARCHAR(20) DEFAULT 'borrador' CHECK (estado IN ('borrador', 'pendiente', 'publicado', 'rechazado')),
    fecha_creacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    fecha_publicacion TIMESTAMP,
    id_creador INT NOT NULL,
    descargas INT DEFAULT 0,
    puntuacion_media DECIMAL(3,2) DEFAULT 0.00,
    visitas INT DEFAULT 0,
    tiempo_jugado_total INT DEFAULT 0,
    FOREIGN KEY (id_creador) REFERENCES usuarios(id_usuario) ON DELETE CASCADE
);

-- Índices para juegos
CREATE INDEX idx_juegos_estado ON juegos(estado);
CREATE INDEX idx_juegos_categoria ON juegos(categoria);
CREATE INDEX idx_juegos_creador ON juegos(id_creador);
CREATE INDEX idx_juegos_puntuacion ON juegos(puntuacion_media);

-- 2.2 Tabla: planes
CREATE TABLE IF NOT EXISTS planes (
    id_plan SERIAL PRIMARY KEY,
    nombre_plan VARCHAR(50) NOT NULL,
    descripcion TEXT,
    precio_mensual DECIMAL(10,2) NOT NULL,
    precio_anual DECIMAL(10,2),
    caracteristicas JSON NOT NULL,
    nivel INT NOT NULL,
    activo BOOLEAN DEFAULT TRUE
);

