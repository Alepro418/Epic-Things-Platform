-- 3. TABLAS DE INTERACCIÓN SOCIAL
-- =============================================================================

-- 3.1 Tabla: valoraciones
CREATE TABLE IF NOT EXISTS valoraciones (
    id_valoracion SERIAL PRIMARY KEY,
    id_usuario INT NOT NULL,
    id_juego INT NOT NULL,
    puntuacion INT NOT NULL CHECK (puntuacion BETWEEN 1 AND 5),
    comentario TEXT,
    fecha_valoracion TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_usuario) REFERENCES usuarios(id_usuario) ON DELETE CASCADE,
    FOREIGN KEY (id_juego) REFERENCES juegos(id_juego) ON DELETE CASCADE,
    UNIQUE (id_usuario, id_juego)
);

-- Índices para valoraciones
CREATE INDEX idx_valoraciones_usuario ON valoraciones(id_usuario);
CREATE INDEX idx_valoraciones_juego ON valoraciones(id_juego);

-- 3.2 Tabla: juegos_favoritos
CREATE TABLE IF NOT EXISTS juegos_favoritos (
    id_usuario INT NOT NULL,
