@startuml
' Título del diagrama
title "Modelo Entidad-Relación - Epic Things Platform"

' Definición de entidades
entity "usuarios" as usuarios {
    * id_usuario : INT <<PK>>
    --
    * username : VARCHAR(50) <<UK>>
    * email : VARCHAR(100) <<UK>>
    * password_hash : VARCHAR(255)
    * nombre_completo : VARCHAR(100)
    fecha_registro : DATETIME
    avatar_url : VARCHAR(255)
    activo : BOOLEAN
    email_verificado : BOOLEAN
    ultimo_acceso : DATETIME
}

entity "roles" as roles {
    * id_rol : INT <<PK>>
    --
    * nombre_rol : VARCHAR(50) <<UK>>
    descripcion : TEXT
    * nivel : INT
}

entity "permisos" as permisos {
    * id_permiso : INT <<PK>>
    --
    * nombre_permiso : VARCHAR(100) <<UK>>
    descripcion : TEXT
    categoria : VARCHAR(50)
}

entity "usuarios_roles" as usuarios_roles {
    * id_usuario : INT <<PK>> <<FK>>
    * id_rol : INT <<PK>> <<FK>>
    --
    fecha_asignacion : DATETIME
}

entity "roles_permisos" as roles_permisos {
    * id_rol : INT <<PK>> <<FK>>
    * id_permiso : INT <<PK>> <<FK>>
    --
    fecha_asignacion : DATETIME
}

entity "juegos" as juegos {
    * id_juego : INT <<PK>>
    --
    * titulo : VARCHAR(150)
    descripcion : TEXT
    categoria : VARCHAR(50)
    * tipo : ENUM('html5','unity','webgl')
    * url_archivo : VARCHAR(255)
    url_imagen : VARCHAR(255)
    url_demo : VARCHAR(255)
    precio : DECIMAL(10,2)
    estado : ENUM('borrador','pendiente','publicado','rechazado')
    fecha_creacion : DATETIME
    fecha_publicacion : DATETIME
    * id_creador : INT <<FK>>
    descargas : INT
    puntuacion_media : DECIMAL(3,2)
    visitas : INT
    tiempo_jugado_total : INT
}

entity "planes" as planes {
    * id_plan : INT <<PK>>
    --
    * nombre_plan : VARCHAR(50)
    descripcion : TEXT
    * precio_mensual : DECIMAL(10,2)
    precio_anual : DECIMAL(10,2)
    * caracteristicas : JSON
    * nivel : INT
    activo : BOOLEAN
}

entity "suscripciones" as suscripciones {
    * id_suscripcion : INT <<PK>>
    --
    * id_usuario : INT <<FK>>
    * id_plan : INT <<FK>>
    id_transaccion : INT <<FK>>
    * fecha_inicio : DATETIME
    * fecha_fin : DATETIME
    estado : ENUM('activa','cancelada','vencida','pendiente')
    periodo : ENUM('mensual','anual')
}

entity "transacciones" as transacciones {
    * id_transaccion : INT <<PK>>
    --
    * id_usuario : INT <<FK>>
    id_suscripcion : INT <<FK>>
    * monto : DECIMAL(10,2)
    moneda : VARCHAR(3)
    * metodo_pago : VARCHAR(50)
    id_pago_externo : VARCHAR(255)
    estado : ENUM('pendiente','completada','fallida','reembolsada')
    fecha_transaccion : DATETIME
    descripcion : VARCHAR(255)
}

entity "valoraciones" as valoraciones {
    * id_valoracion : INT <<PK>>
    --
    * id_usuario : INT <<FK>>
    * id_juego : INT <<FK>>
    * puntuacion : INT (1-5)
    comentario : TEXT
    fecha_valoracion : DATETIME
}

entity "reportes" as reportes {
    * id_reporte : INT <<PK>>
    --
    * id_usuario_reportante : INT <<FK>>
    id_juego_reportado : INT <<FK>>
    id_usuario_reportado : INT <<FK>>
    * tipo : ENUM('juego','comentario','usuario')
    * motivo : VARCHAR(255)
    descripcion : TEXT
    estado : ENUM('pendiente','revisado','resuelto','rechazado')
    fecha_reporte : DATETIME
}

entity "logs_actividad" as logs_actividad {
    * id_log : BIGINT <<PK>>
    --
    id_usuario : INT <<FK>>
    * accion : VARCHAR(100)
    detalles : JSON
    ip_usuario : VARCHAR(45)
    user_agent : VARCHAR(255)
    fecha_accion : DATETIME
}

entity "juegos_favoritos" as juegos_favoritos {
    * id_usuario : INT <<PK>> <<FK>>
    * id_juego : INT <<PK>> <<FK>>
    --
    fecha_agregado : DATETIME
}

' Relaciones
usuarios ||--o{ usuarios_roles : tiene
roles ||--o{ usuarios_roles : "asignado a"
roles ||--o{ roles_permisos : tiene
permisos ||--o{ roles_permisos : "asignado a"

usuarios ||--o{ juegos : crea
usuarios ||--o{ suscripciones : tiene
planes ||--o{ suscripciones : "es parte de"
usuarios ||--o{ transacciones : realiza
suscripciones ||--o{ transacciones : genera

usuarios ||--o{ valoraciones : hace
juegos ||--o{ valoraciones : recibe

usuarios ||--o{ reportes : "reporta (como reportante)"
juegos ||--o{ reportes : "es reportado"
usuarios ||--o{ reportes : "es reportado"

usuarios ||--o{ logs_actividad : genera

usuarios ||--o{ juegos_favoritos : tiene
juegos ||--o{ juegos_favoritos : "es favorito"

' Notas adicionales
note right of juegos
  - Los juegos con precio = 0 son gratuitos.
  - Estado 'pendiente' = esperando revisión.
  - Los creadores pueden ver métricas de sus juegos.
end note

note right of suscripciones
  - Una suscripción activa da acceso a juegos premium.
  - Al expirar, el usuario vuelve a nivel Explorador.
end note

@enduml


================================================================================
4. TABLA DE RELACIONES PRINCIPALES
================================================================================

Relación                       Tipo    Descripción
------------------------------ ------- ------------------------------------------
usuarios → roles               N:M     Un usuario puede tener múltiples roles
                                        (a través de usuarios_roles)
roles → permisos               N:M     Un rol puede tener múltiples permisos
                                        (a través de roles_permisos)
usuarios → juegos              1:N     Un usuario (creador) puede crear
                                        múltiples juegos
usuarios → suscripciones       1:N     Un usuario puede tener múltiples
                                        suscripciones (historial)
planes → suscripciones         1:N     Un plan puede estar asociado a
                                        múltiples suscripciones
usuarios → valoraciones        1:N     Un usuario puede hacer múltiples
                                        valoraciones
juegos → valoraciones          1:N     Un juego puede recibir múltiples
                                        valoraciones
usuarios → reportes            1:N     Un usuario puede reportar múltiples
                                        contenidos
juegos → reportes              1:N     Un juego puede ser reportado
                                        múltiples veces
usuarios → juegos_favoritos    1:N     Un usuario puede tener múltiples
                                        juegos favoritos
juegos → juegos_favoritos      1:N     Un juego puede ser favorito de
                                        múltiples usuarios


================================================================================
5. CONSIDERACIONES DE SEGURIDAD
================================================================================

1. CONTRASEÑAS:
   - Almacenar usando bcrypt o Argon2 (nunca en texto plano).
   - Longitud mínima: 8 caracteres.

2. DATOS SENSIBLES:
   - NO exponer en APIs: password_hash, id_pago_externo, datos de tarjetas.
   - Utilizar DTOs (Data Transfer Objects) para ocultar campos sensibles.

3. LOGS:
   - NO almacenar información sensible en logs_actividad.
   - Ejemplos de lo que NO debe ir en logs: contraseñas, tokens, datos de pago.

4. AUDITORÍA:
   - Mantener registros de acciones críticas:
     * Cambios de rol.
     * Cambios de estado de suscripción.
     * Publicación/eliminación de juegos.
     * Acciones de administración.

5. VALIDACIONES:
   - Validar todos los inputs en el backend (nunca confiar solo en el frontend).
   - Sanitizar entradas para prevenir inyecciones SQL y XSS.

6. ROLES Y PERMISOS:
   - Principio de mínimo privilegio: cada usuario solo tiene los permisos necesarios.
   - Revalidar permisos en cada solicitud al backend.


