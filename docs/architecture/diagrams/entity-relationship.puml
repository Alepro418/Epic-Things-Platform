-- =============================================================================
-- 5. FUNCIONES Y TRIGGERS
-- =============================================================================

-- 5.1 Función: Actualizar puntuación media de un juego
CREATE OR REPLACE FUNCTION actualizar_puntuacion_media()
RETURNS TRIGGER AS $$
BEGIN
    UPDATE juegos
    SET puntuacion_media = (
        SELECT AVG(puntuacion)::DECIMAL(3,2)
        FROM valoraciones
        WHERE id_juego = NEW.id_juego
    )
    WHERE id_juego = NEW.id_juego;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- Trigger: Actualizar puntuación media al insertar o actualizar una valoración
CREATE TRIGGER trg_actualizar_puntuacion_media
AFTER INSERT OR UPDATE ON valoraciones
FOR EACH ROW
EXECUTE FUNCTION actualizar_puntuacion_media();

-- 5.2 Función: Registrar logs de actividad
CREATE OR REPLACE FUNCTION registrar_log()
RETURNS TRIGGER AS $$
BEGIN
    INSERT INTO logs_actividad (id_usuario, accion, detalles)
    VALUES (
        NEW.id_usuario,
        TG_OP || ' ' || TG_TABLE_NAME,
        row_to_json(NEW)
    );
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- =============================================================================
-- 6. VISTAS ÚTILES
-- =============================================================================

-- 6.1 Vista: Usuarios con sus roles
CREATE OR REPLACE VIEW vista_usuarios_roles AS
SELECT 
    u.id_usuario,
    u.username,
    u.nombre_completo,
    u.email,
    u.activo,
    STRING_AGG(r.nombre_rol, ', ') AS roles,
    MAX(r.nivel) AS nivel_maximo
FROM usuarios u
LEFT JOIN usuarios_roles ur ON u.id_usuario = ur.id_usuario
LEFT JOIN roles r ON ur.id_rol = r.id_rol
GROUP BY u.id_usuario;

-- 6.2 Vista: Juegos con información de creador y valoración
CREATE OR REPLACE VIEW vista_juegos_completos AS
SELECT 
    j.id_juego,
    j.titulo,
    j.descripcion,
    j.categoria,
    j.tipo,
    j.precio,
    j.estado,
    j.fecha_creacion,
    j.fecha_publicacion,
    j.descargas,
    j.puntuacion_media,
    j.visitas,
    u.username AS creador_username,
    u.nombre_completo AS creador_nombre,
    COUNT(DISTINCT v.id_valoracion) AS total_valoraciones,
    COUNT(DISTINCT f.id_usuario) AS total_favoritos
FROM juegos j
LEFT JOIN usuarios u ON j.id_creador = u.id_usuario
LEFT JOIN valoraciones v ON j.id_juego = v.id_juego
LEFT JOIN juegos_favoritos f ON j.id_juego = f.id_juego
GROUP BY j.id_juego, u.username, u.nombre_completo;

-- 6.3 Vista: Suscripciones activas
CREATE OR REPLACE VIEW vista_suscripciones_activas AS
SELECT 
    s.id_suscripcion,
    u.username,
    u.nombre_completo,
    p.nombre_plan,
    s.fecha_inicio,
    s.fecha_fin,
    s.periodo,
    DATEDIFF('day', CURRENT_DATE, s.fecha_fin) AS dias_restantes
FROM suscripciones s
JOIN usuarios u ON s.id_usuario = u.id_usuario
JOIN planes p ON s.id_plan = p.id_plan
WHERE s.estado = 'activa' AND s.fecha_fin > CURRENT_DATE;

