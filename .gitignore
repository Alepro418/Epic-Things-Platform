cat > .gitignore << 'EOF'
# ============================================
# VARIABLES DE ENTORNO (NUNCA SUBIR)
# ============================================
.env
.env.local
.env.*.local
*.env
!.env.example

# ============================================
# DEPENDENCIAS
# ============================================
node_modules/
vendor/
__pycache__/
*.pyc
*.pyo
*.pyd
.pnp
.pnp.js

# ============================================
# BUILD Y DIST
# ============================================
dist/
build/
*.min.js
*.min.css
.next/
out/
.vercel/
.netlify/

# ============================================
# LOGS Y TEMPORALES
# ============================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.tmp
*.temp

# ============================================
# IDE Y EDITORES
# ============================================
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ============================================
# DOCKER
# ============================================
*.pid
*.seed
.docker/

# ============================================
# TESTS Y COBERTURA
# ============================================
coverage/
.nyc_output/
*.lcov

# ============================================
# OTROS
# ============================================
*.bak
*.backup
.cache/
temp/
tmp/
EOF